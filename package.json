{
  "name": "olho-de-horus",
  "version": "0.2.0",
  "private": true,
  "description": "Acompanhamento local pós-missão — protótipo em desenvolvimento",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "dev:web": "node server/index.cjs",
    "dev:desktop": "npm run desktop:rebuild && electron . --dev",
    "dev": "npm run dev:desktop",
    "start": "node server/index.cjs",
    "test": "node --test tests/*.test.cjs",
    "build:web": "vite build",
    "desktop:rebuild": "electron-builder install-app-deps",
    "dist:win": "npm run build:web && npm run desktop:rebuild && electron-builder --win nsis portable"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.0.6"
  }
}
